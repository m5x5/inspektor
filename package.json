{
  "name": "inspektor",
  "version": "0.9.0",
  "private": true,
  "description": "Inspect the contents of your remote storage",
  "license": "MIT",
  "author": "",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "repository": "gitlab:skddc/inspektor",
  "ember": {
    "edition": "octane"
  },
  "scripts": {
    "build": "ember build",
    "build-prod": "ember build --environment production && npm run update-version-file",
