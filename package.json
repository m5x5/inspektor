    "tailwindcss": "^4.1.18"
  },
  "engines": {
    "node": ">= 18"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "buffer": "^6.0.3",
    "file-saver": "^2.0.5",
    "framework7": "^8.3.4",
    "jszip": "^3.10.1",
    "process": "^0.11.10",
    "util": "^0.12.5"
