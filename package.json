    "test": "ember test --test-port 0",
    "deploy": "npm run build-prod && bash scripts/deploy.sh",
    "update-version-file": "bash scripts/update-version-file.sh"
  },
  "devDependencies": {
    "@csstools/postcss-sass": "^5.1.1",
