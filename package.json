{
  "name": "inspektor",
  "version": "0.9.0",
  "private": true,
  "description": "Inspect the contents of your remote storage",
  "license": "MIT",
  "author": "",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "repository": "gitlab:skddc/inspektor",
  "scripts": {
    "build": "ember build",
    "build-prod": "ember build --environment production && npm run update-version-file",
    "lint:js": "eslint ./*.js app config lib server tests",
    "start": "ember serve",
    "test": "ember test --test-port 0",
    "deploy": "npm run build-prod && bash scripts/deploy.sh",
    "update-version-file": "bash scripts/update-version-file.sh"
  },
  "devDependencies": {
    "bourbon": "^7.3.0",
    "broccoli-asset-rev": "^2.4.5",
    "ember-ajax": "^3.0.0",
    "ember-browserify": "^1.2.0",
    "ember-cli": "~3.4.4",
    "ember-cli-app-version": "^3.0.0",
    "ember-cli-babel": "^6.18.0",
    "ember-cli-dependency-checker": "^2.0.0",
    "ember-cli-eslint": "^4.2.1",
    "ember-cli-htmlbars": "^3.0.1",
    "ember-cli-htmlbars-inline-precompile": "^1.0.3",
    "ember-cli-shims": "^1.2.0",
    "ember-cli-inject-live-reload": "^1.4.1",
    "ember-cli-qunit": "^4.1.1",
    "ember-cli-sass": "^10.0.1",
    
    "ember-cli-sri": "^2.1.0",
    "ember-cli-uglify": "^2.0.0",
    "ember-data": "~3.4.0",
    "ember-export-application-global": "^2.0.0",
    "ember-load-initializers": "^1.0.0",
    "ember-resolver": "^5.0.1",
    "ember-source": "~3.4.0",
    "eslint-plugin-ember": "^5.0.0",
    "json-tree-view": "github:skddc/json-tree-view#bugfix/setters",
    "loader.js": "^4.7.0",
    "remotestorage-widget": "^1.3.0",
    "remotestoragejs": "^1.1.0",
    "sass": "^1.69.5"
  },
  "engines": {
    "node": "6.* || >= 7.*"
  }
}
