<div class="ember-view">
<div id="app-container" class={{this.connectedClass}}>
  {{#if this.connected}}
    <MenuToggle
      @isOpen={{this.isSidebarOpen}}
      @onClick={{action "toggleSidebar"}}
    />
  {{/if}}

  <aside class="{{if this.isSidebarOpen "sidebar-open" "sidebar-closed"}}">
  {{#if this.connected}}
      <AccountInfo
        @userAddress={{this.userAddress}}
        @onDownloadAll={{this.downloadAllData}}
        @isDownloading={{this.isDownloading}}
      />
      <CategoriesNav @categories={{this.categories}} />
  {{/if}}
  </aside>

  {{#if this.isSidebarOpen}}
    <div class="sidebar-overlay" {{action "closeSidebar"}}></div>
  {{/if}}

  <main>
    {{outlet}}
  </main>
  {{#if this.connected}}
    <BottomNav @categories={{this.categories}} />
  {{/if}}
</div>
</div>
