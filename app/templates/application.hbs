<div id="app-container" class={{connectedClass}}>
  <aside>
    {{#if connected}}
      {{account-info userAddress=userAddress}}
      {{categories-nav categories=categories}}
    {{/if}}
  </aside>
  <main>
    <header>
      {{#if connecting}}
        <!-- Connecting... -->
      {{else}}
        {{#if connected}}
          {{breadcrumb-nav currentDirPath=currentDirPath}}
        {{else}}
          <!-- Please connect. -->
        {{/if}}
      {{/if}}
    </header>

    {{outlet}}
  </main>
</div>