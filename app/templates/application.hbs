<div id="app-container">
  <aside>
    {{#if connected}}
      {{categories-nav categories=categories}}
    {{/if}}
  </aside>
  <main>
    <header>
      {{#if connecting}}
      <!-- Connecting... -->
      {{else}}
        {{#if connected}}
          {{breadcrumb-nav currentDirPath=currentDirPath}}
        {{else}}
          Not connected.
        {{/if}}
      {{/if}}
    </header>

    {{outlet}}
  </main>
</div>