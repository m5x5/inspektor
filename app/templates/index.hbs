<header>
  <BreadcrumbNav @currentDirPath={{this.currentDirPath}} />
  <nav class="actions">
    <button class="button button-small button-fill" title="Create folder" {{on 'click' this.toggleCreateFolder}}>📁+</button>
    <button class="button button-small button-fill" title="Create file" {{on 'click' this.toggleCreateFile}}>📄+</button>
    <button class="button button-small button-fill" title="Upload files" {{on 'click' this.uploadFile}}>⬆️</button>
    {{#if this.currentListingContainsDocuments}}
    <button class="button button-small button-outline color-red delete-all" title="Delete documents/files"
            {{on 'click' this.deleteDocuments}}><Icons::Trash /></button>
    {{/if}}
  </nav>
</header>

{{#if this.showCreateFolder}}
  <div class="modal-overlay" {{on 'click' this.toggleCreateFolder}}>
    <div class="modal" {{on 'click' this.stopPropagation}}>
      <h3>Create Folder</h3>
      <Input @type="text"
             placeholder="Folder name"
             @value={{this.newFolderName}} />
      <div class="modal-actions">
        <button class="button button-fill" {{on 'click' this.createFolder}}>Create</button>
        <button class="button" {{on 'click' this.toggleCreateFolder}}>Cancel</button>
      </div>
    </div>
  </div>
{{/if}}

{{#if this.showCreateFile}}
  <div class="modal-overlay" {{on 'click' this.toggleCreateFile}}>
    <div class="modal" {{on 'click' this.stopPropagation}}>
      <h3>Create File</h3>
      <Input @type="text"
             placeholder="File name"
             @value={{this.newFileName}} />
      <Textarea placeholder="File content (optional)"
                @value={{this.newFileContent}} />
      <div class="modal-actions">
        <button class="button button-fill" {{on 'click' this.createFile}}>Create</button>
        <button class="button" {{on 'click' this.toggleCreateFile}}>Cancel</button>
      </div>
    </div>
  </div>
{{/if}}

{{#if this.currentListing}}
  <DirectoryListing @items={{this.currentListing}} />
{{else}}
  <p style="padding: 20px;">No listing data available.</p>
{{/if}}