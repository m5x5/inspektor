<header>
  <BreadcrumbNav @currentDirPath={{this.currentDirPath}} />
  <nav class="actions">
    {{#if this.metadataHidden}}
      <button class="button button-small button-fill" {{on 'click' this.toggleMetadata}}
              title="Show metadata">
        <Icons::ArrowFromRight />
      </button>
    {{else}}
      <button class="button button-small button-fill" {{on 'click' this.toggleMetadata}}
              title="Hide metadata">
        <Icons::ArrowToRight />
      </button>
    {{/if}}
    {{#if this.publicItemURL}}
      <a class="button button-small button-fill" href={{this.publicItemURL}} target="_blank"
         title="Open document in new tab">
          <Icons::Share />
      </a>
    {{/if}}
    {{#if this.documentIsJSON}}
      <div class="segmented segmented-strong button-group json-view">
        <button disabled={{this.jsonShowTree}}
                class="button button-small {{if this.jsonShowTree "button-active"}}"
                title="Tree view"
                {{on 'click' this.showJsonTree}}>
          <Icons::List />
        </button>
        <button disabled={{this.jsonShowSource}}
                class="button button-small {{if this.jsonShowSource "button-active"}}"
                title="Show source"
                {{on 'click' this.showJsonSource}}>
          <Icons::Code />
        </button>
      </div>
    {{/if}}
    {{#if this.documentIsEditable}}
      <div class="segmented segmented-strong button-group editable">
        <button disabled={{this.documentHideEditor}}
                class="button button-small {{if this.documentHideEditor "button-active"}}"
                title="{{if this.documentHideEditor "Cancel editing"}}"
                {{on 'click' this.cancelEditor}}>
          <Icons::Eye />
        </button>
        <button disabled={{this.documentShowEditor}}
                class="button button-small {{if this.documentShowEditor "button-active"}}"
                {{on 'click' this.showEditor}}>
          <Icons::Edit />
        </button>
      </div>
    {{/if}}
    <button class="button button-small button-outline color-red delete" title="Delete"
            {{on 'click' this.deleteItem}}><Icons::Trash /></button>
  </nav>
</header>

<div class="inspect-details {{if this.metadataHidden "hide-metadata"}}">
  <section class="content">
    <FilePreview 
      @metaData={{this.model.documentMetaData}}
      @isJSON={{this.documentIsJSON}}
      @isEditable={{this.documentIsEditableHide}}
      @showEditor={{this.documentShowEditor}}
      @jsonShowTree={{this.jsonShowTree}}
      @jsonShowSource={{this.jsonShowSource}}
    />
  </section>

  {{#unless this.metadataHidden}}
    <section class="meta">
      <dl>
        <dt>Name</dt>
        <dd>{{this.model.documentMetaData.name}}</dd>
        <dt>Content type</dt>
        <dd>{{this.model.documentMetaData.type}}</dd>
        <dt>Size</dt>
        <dd>{{human-file-size this.model.documentMetaData.size}}</dd>
        <dt>Revision (ETag)</dt>
        <dd>{{this.model.documentMetaData.etag}}</dd>
      </dl>
    </section>
  {{/unless}}
</div>
