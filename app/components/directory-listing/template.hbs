<ul class="listing">
  {{#each this.itemsSorted as |item|}}
  <li>
    {{#if item.isFolder}}
      <LinkTo @route="index" @query={{hash path=item.path}}>
        <span class="icon"><ItemIcon @type={{item.type}} /></span>
        <span class="name">{{item.name}}</span>
        <span class="size"></span>
        <span class="type">{{item.type}}</span>
      </LinkTo>
    {{else}}
      <!-- TODO link to item -->
      <LinkTo @route="inspect" @query={{hash path=item.path}}>
        <span class="icon"><ItemIcon @type={{item.type}} /></span>
        <span class="name">{{item.name}}</span>
        <span class="size">{{human-file-size item.size}}</span>
        <span class="type">{{item.type}}</span>
      </LinkTo>
    {{/if}}
  </li>
  {{/each}}
</ul>
