<span class="username">{{this.username}}</span>
<br><span class="host">{{this.host}}</span>

<button
  class="download-all"
  {{on 'click' @onDownloadAll}}
  disabled={{@isDownloading}}
>
  {{#if @isDownloading}}
    Downloading...
  {{else}}
    Download All Data
  {{/if}}
</button>

<LinkTo @route="disconnect" class="disconnect">disconnect</LinkTo>
