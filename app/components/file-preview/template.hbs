{{#if this.fileLoaded}}
  {{#if this.isBinary}}
    {{#if this.isUnkownBinary}}
      <p>No preview available for this content type.</p>
    {{/if}}
    {{#if this.isImage}}
      <img src={{this.objectURL}} alt={{this.metaData.name}}>
    {{/if}}
    {{#if this.isAudio}}
      <audio src={{this.objectURL}} controls />
    {{/if}}
    {{#if this.isVideo}}
      <video src={{this.objectURL}} controls />
    {{/if}}
  {{/if}}

  {{#if this.isText}}
    {{#if this.isJSON}}
      {{#if this.jsonShowTree}}
        <div id="json-tree-view"></div>
      {{else}}
        <code>{{this.fileContent}}</code>
      {{/if}}
    {{else}}
      <code>{{this.fileContent}}</code>
    {{/if}}
  {{/if}}

  {{#if this.showEditor}}
    <div class="actions">
      <button {{on 'click' this.saveChanges}}
              disabled={{this.uploadingChanges}}
              class="primary">
        Save changes
      </button>
      <button {{on 'click' this.cancelEditor}}
              disabled={{this.uploadingChanges}}
              class="secondary">
        Cancel editing
      </button>
    </div>
  {{/if}}
{{/if}}
