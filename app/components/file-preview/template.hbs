{{#if fileLoaded}}
  {{#if isBinary}}
    {{#if isImage}}
      <img src={{objectURL}} alt={{metaData.name}}>
    {{else}}
      <p>No preview available for this content type.</p>
    {{/if}}
  {{/if}}

  {{#if isText}}
    {{#if isJSON}}
      {{#if jsonShowTree}}
        <div id="json-tree-view"></div>
      {{else}}
        <code>{{fileContent}}</code>
      {{/if}}
    {{else}}
      <code>{{fileContent}}</code>
    {{/if}}
  {{/if}}
{{/if}}